# SEHAT LINK AI provider configuration
# Copy this file to `.env` and fill in your key. Never commit `.env`.

# --- Active provider: Groq (OpenAI-compatible, console.groq.com) ---
# The API key is read from GROQ_API_KEY, or from OPENAI_API_KEY if GROQ_API_KEY
# is empty. It stays on the server only — never exposed to the browser.
GROQ_API_KEY=
OPENAI_API_KEY=

# Groq-compatible API base URL and model
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# --- Alternative provider: xAI Grok ---
# To use xAI/Grok instead, set these (xAI keys look like "xai-...", not "gsk_...").
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# AI_MODEL=grok-4.5

# --- Optional offline demo ---
# Set to "true" ONLY to run the heuristic offline demo without any API key.
# With a key present this is ignored; failures are never silently hidden.
SEHAT_DEMO_MODE=false

# Port for the backend API
PORT=3001